{
  "name": "@mapflux/react",
  "version": "0.1.0",
  "description": "React hooks + Leaflet map components for MapFlux",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.mjs", "require": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "files": ["dist"],
  "scripts": { "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-dom --external leaflet --external react-leaflet", "test": "vitest run", "clean": "rm -rf dist" },
  "peerDependencies": { "@mapflux/core": ">=0.1.0", "react": ">=18", "react-dom": ">=18", "leaflet": ">=1.9", "react-leaflet": ">=4.0" },
  "devDependencies": { "@mapflux/core": "workspace:*", "@types/leaflet": "^1.9.0", "@types/react": "^18.0.0", "react": "^18.0.0", "react-dom": "^18.0.0", "leaflet": "^1.9.0", "react-leaflet": "^4.0.0", "tsup": "^8.0.0", "typescript": "^5.5.0", "vitest": "^2.0.0" }
}
